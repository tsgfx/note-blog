# 生产环境变量模板
#
# 服务器上执行：cp deploy/.env.prod.example .env      （.env 在项目根，已被 gitignore）
# 然后逐项填空。带【必填】的空着启动会直接报错 —— 这是故意的。
#
# 生成随机串：
#   JWT_SECRET:   openssl rand -base64 48
#   DB 密码:       openssl rand -base64 24 | tr -d '/+=' | head -c 24
#   ingest 令牌:   openssl rand -hex 32

# ── 域名与证书【必填】────────────────────────────────────
# 裸域名，不带 https://，不带路径
DOMAIN=notes.example.com
# 证书到期/异常通知邮箱，Let's Encrypt 会发这里
ACME_EMAIL=you@example.com
# RSS 与页面里的绝对地址，必须带 https
SITE_BASE_URL=https://notes.example.com
# 跨域白名单：生产只写真实域名。写 http://localhost:[*] 等于给本机开的；
# 写 IP 通配（192.168.*）更危险 —— Spring 会展开成正则，形似域名也能过
CORS_ALLOWED_ORIGINS=https://notes.example.com

# ── 数据库【必填】────────────────────────────────────────
DB_NAME=notes_blog
DB_USER=notes
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── 应用密钥【必填】──────────────────────────────────────
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 站点 ────────────────────────────────────────────────
SITE_TITLE=私人笔记博客

# ── 模型 ────────────────────────────────────────────────
EMBEDDING_MODEL=bge-m3
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=minimax-m3
LLM_API_KEY=
# Ollama 模型常驻时长，8G 机器别设太长
OLLAMA_KEEP_ALIVE=10m

# ── 限流 ────────────────────────────────────────────────
# 后端按 IP 计数的业务限流；nginx 那层见 deploy/nginx/edge.conf
#
# RATE_LIMIT_ASK 必须 >= GUEST_ASK_IP_DAILY_CEILING：否则游客会先撞上
# 「请求过于频繁，请 60 秒后再试」而不是「今天的提问次数已用完」，语义不对。
# 这层只对匿名调用者生效，管理员自己问答不受影响。
RATE_LIMIT_ASK=25
RATE_LIMIT_SEARCH=60
# 阅读量上报：正常读者一篇一个会话只报一次，30/分钟只挡脚本。
# 不设的话一个 curl 循环就能把任意文章刷成「热门第一」。
RATE_LIMIT_VIEW=30

# ── 游客问答额度 ────────────────────────────────────────
# ALLOWANCE：对单个浏览器的承诺值，前端据此显示「今日还可提问 N 次」。
# CEILING：按 IP 的服务端硬上限，落库（重启不清零）。刻意大于 ALLOWANCE——
# 手机流量和不少宽带是共享出口 IP，严格按承诺值会让同楼的人问不了。
GUEST_ASK_DAILY_ALLOWANCE=5
GUEST_ASK_IP_DAILY_CEILING=15

# ── 资源监控页（可选）────────────────────────────────────
# /monitor 页面反代的 Beszel 地址。公网部署一般不接内网监控，留空则该页 502
# MONITOR_UPSTREAM=

# ── 异地备份（服务器 → COS）【可选】──────────────────────
# scripts/backup-cloud.sh 在每日备份成功后，把 dump 加密后传到 COS。
# 不填则只在服务器本地保留备份。配置放 /opt/note-blog/.backup-cos.env（600），不进仓库。
#
# 【重要】COS_BUCKET 请填**专门建的私有桶**，不要复用图片桶：
#   脚本会给每个对象标 --acl private 并上传前 AES-256 加密，双重保护，
#   但「把数据库 dump 放进一个设计上公有读的桶里」本身就不该是默认做法。
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=你的备份私有桶名
# COS_REGION=ap-beijing
# COS_BACKUP_PREFIX=backups/
