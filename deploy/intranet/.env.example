# 校园内网部署变量模板
#
# 用法：cp deploy/intranet/.env.example .env，把 10.20.30.40 换成你服务器的内网地址。
#
# 和公网版的区别：
#   1. 没有公网域名、签不出证书 → 不启动 Caddy，走明文 HTTP（内网可接受）
#   2. SITE_BASE_URL / CORS_ALLOWED_ORIGINS 必须是**内网访问地址**，不是域名
#   3. DOMAIN / ACME_EMAIL 仍要填：公网编排里 caddy 用了 :? 强校验，
#      不填 compose 解析时就报错。填什么都行，因为 caddy 根本不会启动。

# ── 占位，随便填（caddy 不启动）──────────────────────────
DOMAIN=intranet.invalid
ACME_EMAIL=intranet@example.com

# ── 内网访问地址【必填】──────────────────────────────────
# 写你实际在浏览器里敲的地址：IP 或学校内网 DNS 名，带端口
SITE_BASE_URL=http://10.20.30.40
# 允许的跨域来源：浏览器即使同源发 POST 也带 Origin，不在名单里就是「页面能开、接口全 403」。
# 用主机名访问就把主机名也列上，多条用逗号分隔
CORS_ALLOWED_ORIGINS=http://10.20.30.40
# 前端对外端口（默认 80，非 root 环境改成 8080 之类）
APP_PORT=80

# ── 数据库【必填】────────────────────────────────────────
DB_NAME=notes_blog
DB_USER=notes
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── 应用密钥【必填】──────────────────────────────────────
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 站点 ────────────────────────────────────────────────
SITE_TITLE=私人笔记博客

# ── 模型 ────────────────────────────────────────────────
# 内网机器通常是实验室服务器，显存/内存比云主机宽裕，但别让它常驻吃满
EMBEDDING_MODEL=bge-m3
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=minimax-m3
LLM_API_KEY=
OLLAMA_KEEP_ALIVE=10m

# ── 限流 ────────────────────────────────────────────────
RATE_LIMIT_ASK=10
RATE_LIMIT_SEARCH=60
RATE_LIMIT_VIEW=30

# ── 消息通知（可选）──────────────────────────────────────
# 新评论产生时即时推送给作者（飞书、钉钉、企微机器人、Bark 或通用 Webhook）
NOTIFICATION_WEBHOOK_URL=
