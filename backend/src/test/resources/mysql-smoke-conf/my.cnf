# 烟雾测试用 MySQL 配置，挂进容器的 /etc/mysql/conf.d/
#
# 为什么要有这个文件：Testcontainers 1.21.4 自带一份 mysql-default-conf/my.cnf，
# 里面有 `innodb_log_file_size = 5M`。这个变量在 MySQL 9.7 已被删除（换成
# innodb_redo_log_capacity），而 `mysql:9` 是浮动标签——2026-10-29 起解析到
# 9.7.4，容器直接 `unknown variable 'innodb_log_file_size=5M'` 起不来。
#
# 为什么不能用 withCommand 追加参数绕过：那是配置文件里的项，命令行覆盖不掉
# （原来测试里的 .withCommand(...) 从来没起过作用，只是当时镜像还认这个变量）。
# 唯一起作用的开关是 withConfigurationOverride，它会**整份替换**默认配置目录，
# 所以这里必须写一份完整可用的配置，不能只写差异项。
#
# 数值都刻意调小：CI runner 只有几 G 内存，默认 buffer pool 会 OOM。
# 只在烟雾测试里用（验证 JPA 映射与启动期 DDL），不代表生产配置。

[mysqld]
user = mysql
datadir = /var/lib/mysql
port = 3306
skip-name-resolve

# 原来用 withCommand 传的两个参数，挪到这里（withCommand 已不再使用）
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# 测试只建几十张空表，够用即可
key_buffer_size = 16K
max_allowed_packet = 1M
table_open_cache = 4
sort_buffer_size = 64K
read_buffer_size = 256K
read_rnd_buffer_size = 256K
net_buffer_length = 2K
host_cache_size = 0

innodb_data_file_path = ibdata1:10M:autoextend
innodb_buffer_pool_size = 16M
innodb_log_buffer_size = 8M
# 注意：不要加 innodb_log_file_size，9.7 已删除
innodb_flush_log_at_trx_commit = 1
innodb_lock_wait_timeout = 50
