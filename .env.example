# 私人笔记博客 · 本地配置模板
# 用法：cp .env.example .env，再把下面标了「必改」的项换成自己的值。
# .env 已被 .gitignore 忽略，不要提交。

# ── 问答模型（OpenCode Go 网关）────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=minimax-m3

# ── 数据库（容器部署时改成 mysql 服务名）──────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=notes_blog
DB_USER=notes
DB_PASSWORD=notes_dev_pw

# ── 向量化（backend=ollama 走本地 Ollama；backend=openai 走 OpenAI 兼容 API）──
# openai 模式示例（云端部署推荐，省 ~1.5G 内存）：
#   EMBEDDING_BACKEND=openai
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_MODEL=BAAI/bge-m3
# 注意：换模型/换维度需重建 note_chunks 索引；bge-m3（1024 维）可无缝切换。
# 容器里跑 ollama 后端时，base-url 保持默认 http://ollama:11434
EMBEDDING_BACKEND=ollama
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# ── 管理员账号【必改：密码】────────────────────────────────
# 只在首次建库时用来创建管理员；库里已有该账号后，改这里不会覆盖密码。
# 之后要改密码请登录后走「设置」页面（改密会吊销所有已登录设备）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# ── JWT 签名密钥【必改】────────────────────────────────────
# 至少 32 字节；生成方式：openssl rand -base64 48
JWT_SECRET=

# ── 博客对外地址（RSS 里的链接前缀）────────────────────────
# 容器部署时用 SITE_BASE_URL_CONTAINER，默认 http://localhost:8088
SITE_BASE_URL=http://localhost:5173
SITE_TITLE=私人笔记博客

# ── 允许的跨域来源【换域名/端口必改】──────────────────────
# 浏览器即使同源发 POST 也会带 Origin 头，不在名单里会被 403（页面能开、接口全挂）。
# 逗号分隔，不带结尾斜杠。上线换域名时把这里改成真实地址，例如：
#   CORS_ALLOWED_ORIGINS=https://notes.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
